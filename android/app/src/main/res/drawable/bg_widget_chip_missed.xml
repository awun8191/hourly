<?xml version="1.0" encoding="utf-8"?>
<!-- The MISSED chip: an outline, not a filled pill, so a missed hour is quieter
     than a done one and cannot be read as the green in place chip -->
<shape xmlns:android="http://schemas.android.com/apk/res/android"
    android:shape="rectangle">
    <stroke
        android:width="1dp"
        android:color="@color/widget_missed_stroke" />
    <corners android:radius="20dp" />
</shape>
