<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/slot_row"
    android:layout_width="match_parent"
    android:layout_height="26dp"
    android:gravity="center_vertical"
    android:orientation="horizontal"
    android:paddingStart="2dp"
    android:paddingEnd="0dp">

    <View
        android:id="@+id/slot_bar"
        android:layout_width="3dp"
        android:layout_height="14dp"
        android:background="@drawable/bg_row_bar_empty" />

    <TextView
        android:id="@+id/slot_hour"
        android:layout_width="46dp"
        android:layout_height="wrap_content"
        android:layout_marginStart="8dp"
        android:fontFeatureSettings="tnum"
        android:includeFontPadding="false"
        android:textColor="@color/widget_muted"
        android:textSize="10.5sp" />

    <TextView
        android:id="@+id/slot_text"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_weight="1"
        android:ellipsize="end"
        android:includeFontPadding="false"
        android:maxLines="1"
        android:textColor="@color/widget_text"
        android:textSize="12.5sp" />

    <TextView
        android:id="@+id/slot_status"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginStart="8dp"
        android:background="@drawable/bg_widget_chip_active"
        android:letterSpacing="0.08"
        android:paddingStart="8dp"
        android:paddingTop="2dp"
        android:paddingEnd="8dp"
        android:paddingBottom="2dp"
        android:textColor="@color/widget_active_text"
        android:textSize="8.5sp"
        android:textStyle="bold" />
</LinearLayout>
