<?xml version="1.0" encoding="utf-8"?>
<!-- Quiet line for a body with no other hours. Wrap content, top aligned: it
     used to carry weight 1, which stretched it and pushed the footer down. -->
<TextView xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/widget_filler_line"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginTop="8dp"
    android:ellipsize="end"
    android:includeFontPadding="false"
    android:maxLines="2"
    android:paddingStart="2dp"
    android:textColor="@color/widget_muted"
    android:textSize="11.5sp" />
