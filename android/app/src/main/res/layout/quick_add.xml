<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_margin="24dp"
    android:background="@drawable/bg_widget"
    android:orientation="vertical"
    android:padding="20dp">

    <TextView
        android:id="@+id/quick_title"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:textColor="@color/widget_text"
        android:textSize="18sp"
        android:textStyle="bold" />

    <EditText
        android:id="@+id/quick_text"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="12dp"
        android:backgroundTint="@color/widget_muted"
        android:hint="@string/quick_hint"
        android:inputType="textCapSentences"
        android:maxLines="3"
        android:minLines="1"
        android:textColor="@color/widget_text"
        android:textColorHint="@color/widget_muted"
        android:textSize="16sp" />

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="16dp"
        android:gravity="end"
        android:orientation="horizontal">

        <Button
            android:id="@+id/quick_clear"
            style="?android:attr/borderlessButtonStyle"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/quick_clear"
            android:textColor="@color/widget_done_text" />

        <Button
            android:id="@+id/quick_cancel"
            style="?android:attr/borderlessButtonStyle"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/quick_cancel"
            android:textColor="@color/widget_muted" />

        <Button
            android:id="@+id/quick_save"
            style="?android:attr/borderlessButtonStyle"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/quick_save"
            android:textColor="@color/widget_accent"
            android:textStyle="bold" />
    </LinearLayout>
</LinearLayout>
