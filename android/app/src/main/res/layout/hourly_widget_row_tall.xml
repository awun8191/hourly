<?xml version="1.0" encoding="utf-8"?>
<!-- One hour row in the tall bucket: the medium row (hourly_widget_row) at
     44dp instead of 40dp, matching WidgetSize.ROW_HEIGHT_LARGE_DP. Fixed and
     top aligned, never weighted. -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/slot_row"
    android:layout_width="match_parent"
    android:layout_height="44dp"
    android:layout_marginTop="6dp"
    android:gravity="center_vertical"
    android:orientation="horizontal"
    android:paddingStart="2dp"
    android:paddingEnd="0dp">

    <TextView
        android:id="@+id/slot_bar"
        android:layout_width="3dp"
        android:layout_height="match_parent"
        android:layout_marginTop="7dp"
        android:layout_marginBottom="7dp"
        android:background="@drawable/bg_row_bar_empty" />

    <TextView
        android:id="@+id/slot_hour"
        android:layout_width="50dp"
        android:layout_height="wrap_content"
        android:layout_marginStart="8dp"
        android:fontFeatureSettings="tnum"
        android:letterSpacing="0.02"
        android:includeFontPadding="false"
        android:textColor="@color/widget_muted"
        android:textSize="12.5sp" />

    <TextView
        android:id="@+id/slot_text"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_weight="1"
        android:ellipsize="end"
        android:includeFontPadding="false"
        android:maxLines="1"
        android:textColor="@color/widget_text"
        android:textSize="14sp" />

    <TextView
        android:id="@+id/slot_status"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginStart="8dp"
        android:background="@drawable/bg_widget_chip_active"
        android:letterSpacing="0.08"
        android:paddingStart="9dp"
        android:paddingTop="4dp"
        android:paddingEnd="9dp"
        android:paddingBottom="4dp"
        android:textColor="@color/widget_active_text"
        android:textSize="10.5sp"
        android:textStyle="bold" />
</LinearLayout>
