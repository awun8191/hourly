<?xml version="1.0" encoding="utf-8"?>
<!-- Tall bucket (4x6 or a full screen card): the day in hour order, the live
     hour as the hero, then one deliberate block that takes the height the rows
     do not use: the 24 hour day strip (one tick per hour, 00 to 23), the hour
     labels, the quiet line, the count, and the legend.

     The strip used to sit in the header at 10dp with no children, which is why
     the screenshot showed a wide grey band under the brand line instead of a
     meter. It lives here now, where it is next to the count it explains. -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/bg_widget"
    android:orientation="vertical"
    android:paddingStart="18dp"
    android:paddingTop="14dp"
    android:paddingEnd="18dp"
    android:paddingBottom="14dp">

    <!-- Brand and day -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center_vertical"
        android:orientation="horizontal">

        <TextView
            android:id="@+id/widget_brand"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:letterSpacing="0.18"
            android:text="@string/widget_brand"
            android:textColor="@color/widget_accent"
            android:textSize="11.5sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/widget_day"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:letterSpacing="0.08"
            android:textColor="@color/widget_muted"
            android:textSize="12.5sp"
            android:textStyle="bold" />
    </LinearLayout>

    <!-- The day in hour order, earlier hours included, live hour as the hero.
         Wrap content: fixed rows do not grow, so the body never spreads. -->
    <LinearLayout
        android:id="@+id/widget_body"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="6dp"
        android:orientation="vertical" />

    <!-- The height the rows leave over, spent on the day at a glance -->
    <LinearLayout
        android:id="@+id/widget_day_panel"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_marginTop="10dp"
        android:layout_weight="1"
        android:gravity="center_vertical"
        android:orientation="vertical">

        <!-- 24 ticks, one per hour of the day, added by the provider -->
        <LinearLayout
            android:id="@+id/widget_day_strip"
            android:layout_width="match_parent"
            android:layout_height="8dp"
            android:gravity="center_vertical"
            android:orientation="horizontal" />

        <!-- 00, 06, 12, 18: four six hour buckets, each label under its tick -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="3dp"
            android:orientation="horizontal">

            <TextView
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="6"
                android:includeFontPadding="false"
                android:text="@string/widget_axis_00"
                android:textColor="@color/widget_muted"
                android:textSize="10sp" />

            <TextView
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="6"
                android:includeFontPadding="false"
                android:text="@string/widget_axis_06"
                android:textColor="@color/widget_muted"
                android:textSize="10sp" />

            <TextView
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="6"
                android:includeFontPadding="false"
                android:text="@string/widget_axis_12"
                android:textColor="@color/widget_muted"
                android:textSize="10sp" />

            <TextView
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="6"
                android:includeFontPadding="false"
                android:text="@string/widget_axis_18"
                android:textColor="@color/widget_muted"
                android:textSize="10sp" />
        </LinearLayout>

        <TextView
            android:id="@+id/widget_nothing_line"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="6dp"
            android:ellipsize="end"
            android:includeFontPadding="false"
            android:maxLines="1"
            android:text="@string/widget_nothing_else"
            android:textColor="@color/widget_muted"
            android:textSize="11.5sp"
            android:visibility="gone" />

        <TextView
            android:id="@+id/widget_progress"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="6dp"
            android:ellipsize="end"
            android:includeFontPadding="false"
            android:letterSpacing="0.02"
            android:maxLines="1"
            android:textColor="@color/widget_muted"
            android:textSize="12sp" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="3dp"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:includeFontPadding="false"
                android:text="@string/widget_legend_in_place"
                android:textColor="@color/widget_active_text"
                android:textSize="11sp"
                android:textStyle="bold" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:includeFontPadding="false"
                android:paddingStart="5dp"
                android:paddingEnd="5dp"
                android:text="@string/widget_legend_separator"
                android:textColor="@color/widget_muted"
                android:textSize="11sp" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:includeFontPadding="false"
                android:text="@string/widget_legend_done"
                android:textColor="@color/widget_done_text"
                android:textSize="11sp"
                android:textStyle="bold" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:includeFontPadding="false"
                android:paddingStart="5dp"
                android:paddingEnd="5dp"
                android:text="@string/widget_legend_separator"
                android:textColor="@color/widget_muted"
                android:textSize="11sp" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:includeFontPadding="false"
                android:text="@string/widget_legend_missed"
                android:textColor="@color/widget_missed_text"
                android:textSize="11sp"
                android:textStyle="bold" />
        </LinearLayout>
    </LinearLayout>
</LinearLayout>
