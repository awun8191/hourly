<?xml version="1.0" encoding="utf-8"?>
<!-- One hour of the 24 hour day strip. A TextView because RemoteViews does not
     accept a plain View. One of these per hour is added by
     HourlyWidgetProvider.bindDayStrip: weight 1 spreads the 24 hours evenly
     across the card, so a tick sits under its hour from 00:00 to 23:00.

     layout_weight is the fix for the invisible meter: the old segment was
     width 0dp with no weight, so every segment measured to nothing and the
     meter painted as an empty band under the header. -->
<TextView xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/segment_body"
    android:layout_width="0dp"
    android:layout_height="8dp"
    android:layout_marginStart="2dp"
    android:layout_weight="1"
    android:background="@drawable/bg_widget_seg_free" />
